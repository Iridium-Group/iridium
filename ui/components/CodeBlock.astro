---
interface Props {
  code: string;
  label?: string;
}
const { code, label = "Shell" } = Astro.props;
---

<figure class="ir-code">
  <figcaption class="ir-code__bar">
    <span class="ir-code__label">{label}</span>
    <button class="ir-code__copy" type="button" data-copy={code} hidden>
      Copy
    </button>
  </figcaption>
  <pre><code>{code}</code></pre>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".ir-code__copy")) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Copy failed";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>

<style>
  .ir-code {
    margin: 0;
    background: var(--ir-surface);
    border: 1px solid var(--ir-border);
    border-radius: var(--ir-radius);
    overflow: hidden;
  }
  .ir-code__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.5rem 0.375rem 0.875rem;
    border-bottom: 1px solid var(--ir-border);
  }
  .ir-code__label {
    font-family: var(--ir-font-mono);
    font-size: 0.75rem;
    color: var(--ir-text-muted);
  }
  .ir-code__copy {
    font: inherit;
    font-size: 0.75rem;
    color: var(--ir-text-muted);
    background: transparent;
    border: 1px solid var(--ir-border);
    border-radius: 4px;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
  }
  .ir-code__copy:hover {
    color: var(--ir-text);
    border-color: var(--ir-border-strong);
  }
  pre {
    margin: 0;
    padding: 0.875rem;
    overflow-x: auto;
    color: var(--ir-text);
    line-height: 1.6;
  }
</style>
