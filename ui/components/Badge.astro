---
interface Props {
  tone?: "neutral" | "accent";
}
const { tone = "neutral" } = Astro.props;
---

<span class:list={["ir-badge", `ir-badge--${tone}`]}>
  <slot />
</span>

<style>
  .ir-badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--ir-border);
    border-radius: 4px;
    font-family: var(--ir-font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ir-text-muted);
    white-space: nowrap;
  }
  .ir-badge--accent {
    border-color: color-mix(in srgb, var(--ir-accent) 45%, var(--ir-border));
    color: var(--ir-accent-soft);
  }
</style>
