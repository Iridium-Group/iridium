---
export interface NavLink {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  homeHref: string;
  markSrc: string;
  links: NavLink[];
  current?: string;
}
const { homeHref, markSrc, links, current } = Astro.props;
---

<header class="ir-nav">
  <div class="ir-nav__inner ir-container">
    <a class="ir-nav__brand" href={homeHref}>
      <img src={markSrc} alt="" width="40" height="22" />
      <span>Iridium</span>
      <span class="ir-visually-hidden"> Group, home</span>
    </a>
    <nav aria-label="Primary">
      <ul class="ir-nav__links">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={current === link.href ? "page" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .ir-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ir-border);
    background: color-mix(in srgb, var(--ir-bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }
  .ir-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }
  .ir-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ir-text);
    text-decoration: none;
    font-family: var(--ir-font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }
  .ir-nav__brand img {
    width: 40px;
    height: auto;
  }
  .ir-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ir-nav__links a {
    display: inline-block;
    padding: 0.375rem 0.625rem;
    border-radius: var(--ir-radius-sm);
    color: var(--ir-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .ir-nav__links a:hover {
    color: var(--ir-text);
    background: var(--ir-surface-2);
  }
  .ir-nav__links a[aria-current="page"] {
    color: var(--ir-text);
    box-shadow: inset 0 -1px 0 var(--ir-accent);
    border-radius: 0;
  }
  @media (max-width: 40rem) {
    .ir-nav {
      position: static;
    }
    .ir-nav__links {
      margin-inline: -0.625rem;
    }
    .ir-nav__links a {
      padding: 0.5rem 0.625rem;
    }
  }
</style>
