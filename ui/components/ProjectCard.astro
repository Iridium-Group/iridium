---
import Status from "./Status.astro";
import Badge from "./Badge.astro";
import type { StatusId } from "../status";

interface Props {
  name: string;
  description: string;
  status: StatusId;
  tech?: string[];
  kind?: string;
  license?: string;
  packageName?: string;
  github: string;
  docs?: string;
  compact?: boolean;
}
const {
  name,
  description,
  status,
  tech = [],
  kind,
  license,
  packageName,
  github,
  docs,
  compact = false,
} = Astro.props;
---

<li class:list={["ir-project", { "ir-project--compact": compact }]}>
  <div class="ir-project__head">
    <h3 class="ir-project__name">
      <a href={github} rel="noopener noreferrer">
        {name}
      </a>
    </h3>
    {kind && <span class="ir-project__kind">{kind}</span>}
  </div>
  <div class="ir-project__body">
    <p class="ir-project__desc">{description}</p>
    {!compact && (
      <dl class="ir-project__meta">
        {packageName && (
          <div>
            <dt>Package</dt>
            <dd>
              <code>{packageName}</code>
            </dd>
          </div>
        )}
        {license && (
          <div>
            <dt>License</dt>
            <dd>{license}</dd>
          </div>
        )}
        {tech.length > 0 && (
          <div>
            <dt>Tech</dt>
            <dd class="ir-project__tech">
              {tech.map((t) => (
                <Badge>{t}</Badge>
              ))}
            </dd>
          </div>
        )}
      </dl>
    )}
  </div>
  <div class="ir-project__side">
    <Status status={status} />
    <span class="ir-project__links">
      <a href={github} rel="noopener noreferrer">
        GitHub<span class="ir-visually-hidden"> repository for {name}</span>
      </a>
      {docs && (
        <a href={docs} rel="noopener noreferrer">
          Docs<span class="ir-visually-hidden"> for {name}</span>
        </a>
      )}
    </span>
  </div>
</li>

<style>
  .ir-project {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) 1fr auto;
    gap: 0.5rem 2rem;
    align-items: start;
    padding-block: 1.375rem;
    border-top: 1px solid var(--ir-border);
  }
  .ir-project--compact {
    padding-block: 1.125rem;
  }
  .ir-project__name {
    font-family: var(--ir-font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .ir-project__name a {
    color: var(--ir-text);
    text-decoration: none;
  }
  .ir-project__name a:hover {
    color: var(--ir-accent-soft);
    text-decoration: underline;
  }
  .ir-project__kind {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--ir-text-muted);
  }
  .ir-project__desc {
    color: var(--ir-text-muted);
    max-width: 40rem;
  }
  .ir-project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin: 0.875rem 0 0;
    font-size: 0.8125rem;
  }
  .ir-project__meta dt {
    color: var(--ir-text-muted);
    font-family: var(--ir-font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ir-project__meta dd {
    margin: 0.25rem 0 0;
    color: var(--ir-text-muted);
  }
  .ir-project__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .ir-project__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.625rem;
  }
  .ir-project__links {
    display: flex;
    gap: 0.875rem;
    font-size: 0.875rem;
  }
  @media (max-width: 52rem) {
    .ir-project {
      grid-template-columns: 1fr;
      gap: 0.625rem;
    }
    .ir-project__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
    .ir-project__kind {
      margin-top: 0;
    }
    .ir-project__side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
