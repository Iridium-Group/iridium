---
interface Props {
  as?: "div" | "article" | "section" | "li";
}
const { as: Tag = "div" } = Astro.props;
---

<Tag class="ir-card">
  <slot />
</Tag>

<style>
  .ir-card {
    background: color-mix(in srgb, var(--ir-surface) 72%, transparent);
    -webkit-backdrop-filter: var(--ir-glass-blur);
    backdrop-filter: var(--ir-glass-blur);
    border: 1px solid var(--ir-border);
    border-radius: var(--ir-radius);
    padding: 1.25rem;
  }
</style>
