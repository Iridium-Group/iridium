---
import Base from "../layouts/Base.astro";
import Button from "../../ui/components/Button.astro";
import { href } from "../lib/paths";
---

<Base title="Page not found" description="This page does not exist on the Iridium Group website.">
  <header class="page-head nf">
    <div class="ir-container">
      <p class="ir-eyebrow">Error 404</p>
      <h1>This page does not exist.</h1>
      <p>The link may be out of date, or the address may have a typo.</p>
      <div class="nf__actions">
        <Button href={href("/")}>Go to the home page</Button>
        <Button href={href("/projects/")} variant="secondary">
          Browse projects
        </Button>
      </div>
    </div>
  </header>
</Base>

<style>
  .nf {
    border-bottom: 0;
    min-height: 50vh;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
