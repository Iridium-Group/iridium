---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "../../ui/tokens.css";
import "../../ui/base.css";
import Nav from "../../ui/components/Nav.astro";
import Footer from "../../ui/components/Footer.astro";
import { site } from "../data/site";
import { href } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const { title, description = site.description, current } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname.slice(basePath.length).replace(/^\//, ""), site.url)
  .href;
const ogImage = new URL("og.png", site.url).href;

const links = [
  { label: "Projects", href: href("/projects/") },
  { label: "Infrastructure", href: href("/infrastructure/") },
  { label: "Docs", href: site.docs, external: true },
  { label: "Community", href: href("/community/") },
  { label: "GitHub", href: site.github, external: true },
];

const footerGroups = [
  {
    heading: "Site",
    links: [
      { label: "Projects", href: href("/projects/") },
      { label: "Infrastructure", href: href("/infrastructure/") },
      { label: "Community", href: href("/community/") },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Documentation", href: site.docs },
      { label: "Status page", href: site.status },
      { label: "Security policy", href: site.security },
    ],
  },
  {
    heading: "GitHub",
    links: [
      { label: "Organization", href: site.github },
      { label: "Discussions", href: site.discussions },
      { label: "Website source", href: site.repo },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("/favicon.ico")} sizes="any" />
    <link rel="icon" href={href("/iridium-mark.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="The Iridium Group mark" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="ir-skip-link" href="#main">
      Skip to content
    </a>
    <Nav homeHref={href("/")} markSrc={href("/iridium-mark.svg")} links={links} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      markSrc={href("/iridium-mark.svg")}
      name={site.name}
      description={site.description}
      groups={footerGroups}
      note="Code and content are MIT licensed unless a project states otherwise. Sites are deployed via GitHub Pages."
    />
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
  .page-head {
    padding-block: clamp(3.5rem, 8vw, 6rem) 2.5rem;
    border-bottom: 1px solid var(--ir-border);
  }
  .page-head h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    max-width: 22ch;
    margin-top: 0.75rem;
  }
  .page-head p {
    margin-top: 1.25rem;
    max-width: 42rem;
    color: var(--ir-text-muted);
    font-size: 1.0625rem;
  }
  .section {
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
  }
  .section--tight {
    padding-top: 1rem;
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) 1fr;
    gap: 0.75rem 2rem;
    align-items: baseline;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .section-head p {
    grid-column: 2;
    color: var(--ir-text-muted);
    max-width: 40rem;
  }
  .prose {
    max-width: 42rem;
    color: var(--ir-text-muted);
  }
  .prose > * + * {
    margin-top: 1rem;
  }
  .prose h3 {
    color: var(--ir-text);
    font-size: 1.125rem;
    margin-top: 2rem;
  }
  .prose strong {
    color: var(--ir-text);
    font-weight: 500;
  }
  .row-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--ir-border);
  }
  @media (max-width: 52rem) {
    .section-head {
      grid-template-columns: 1fr;
    }
    .section-head p {
      grid-column: 1;
    }
  }
</style>
